{
  "name": "agrichain-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for AgriChain decentralized agricultural marketplace",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8545",
    "chain:persistent": "node ganache-server.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "seed:demo": "hardhat run scripts/seed-demo-catalog.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "ganache": "^7.9.2",
    "hardhat": "^2.22.5"
  }
}
